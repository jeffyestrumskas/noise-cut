# Human mode (./noise-cut.py, explain.py). Copy to config/user.env, chmod 600.

# Elastic: the Elasticsearch endpoint (Kibana -> Help -> Connection details), not .kb. or .ingest.
ELASTIC_URL=https://<project>.es.<region>.<provider>.elastic.cloud
# KIBANA_URL=https://<project>.kb.<region>.<provider>.elastic.cloud   # optional, defaults to .es. -> .kb.
# Event filter key: logs-* read, Security "Event Filters: All", "Global artifact management: All",
# nothing else (see README, "Keys").
ELASTIC_API_KEY=<event filter API key>
