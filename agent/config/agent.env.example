# Agent mode (deploy/run.sh). Copy to config/agent.env, chmod 600.
# No Elastic key here: config/read.env holds the read-only key, config/write.env the event filter key
# (only for NOISE_DRY_RUN=0), each as ELASTIC_API_KEY=<key>. See README, Keys.

# The Elasticsearch endpoint (Kibana -> Help -> Connection details), not .kb. or .ingest.
ELASTIC_URL=https://<project>.es.<region>.<provider>.elastic.cloud
# KIBANA_URL=https://<project>.kb.<region>.<provider>.elastic.cloud   # optional, defaults to .es. -> .kb.

# Who runs the proposer and validator: ollama (default) or venice.
NOISE_PROVIDER=ollama

# ollama.com, or your own Ollama (http://<host>:11434, no key needed).
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=<ollama.com API key>

# venice.ai: pick models that support function calling (GET https://api.venice.ai/api/v1/models).
# VENICE_API_KEY=<venice.ai API key>

# Two different models: one proposes filters, the other checks them.
NOISE_PROPOSER=kimi-k3
NOISE_VALIDATOR=deepseek-v4.1-flash:1017

# Your internal domains (comma separated): every name under them is pseudonymized before a model sees it.
# NOISE_INTERNAL_DOMAINS=corp.example.com
# Your host names, short or full (comma separated). Hosts that send events are found on their own.
# NOISE_INTERNAL_HOSTNAMES=nas, printer.corp.example.com, router
# A local Ollama, never ollama.com, whose model looks at every new line before it leaves and finds the
# names the lists above missed. The model must already be loaded there. Unset: lists and patterns only.
# NOISE_SANITIZER_URL=http://10.1.2.3:11434
# NOISE_SANITIZER_MODEL=llama3.3:70b

# Optional limits: filters per run, tokens per model step, largest share of events one filter may hide.
NOISE_MAX_FILTERS=5
NOISE_MAX_TOKENS=3000000
NOISE_MAX_SHARE=1
