{
  "__inputs": [
    {
      "name": "DS_INFLUXDB",
      "label": "InfluxDB (Flux)",
      "description": "An InfluxDB data source set to the Flux query language",
      "type": "datasource",
      "pluginId": "influxdb",
      "pluginName": "InfluxDB"
    }
  ],
  "__requires": [
    {
      "type": "datasource",
      "id": "influxdb",
      "name": "InfluxDB",
      "version": "1.0.0"
    }
  ],
  "title": "Noise Cut: ingest and savings",
  "uid": "noise-cut-savings",
  "tags": [
    "noise-cut"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "refresh": "1h",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "bucket",
        "label": "Bucket",
        "type": "textbox",
        "query": "noise-cut",
        "current": {
          "text": "noise-cut",
          "value": "noise-cut"
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Filter savings: every Elastic Defend event filter",
      "collapsed": false,
      "panels": [],
      "id": 101,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "title": "Saved by all filters ($/month)",
      "description": "Sum over filters of saved GB/day x 30 x the ingest rate on the latest bill (ECU/GB) x ECU_USD. Baselines are the events/day each filter matched when it was made, so this is an estimate; compare with the daily ingest GB below.",
      "type": "stat",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"noise_savings_total\" and r.source == \"all\" and r._field == \"saved_usd_month\")\n  |> keep(columns: [\"_time\", \"_value\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "noValue": "0",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "value"
      },
      "id": 102,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 5,
        "h": 4
      }
    },
    {
      "title": "Saved events/day",
      "description": "Baseline events/day less what still matches now, summed over all event filters.",
      "type": "stat",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"noise_savings_total\" and r.source == \"all\" and r._field == \"saved_per_day\")\n  |> keep(columns: [\"_time\", \"_value\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "value"
      },
      "id": 103,
      "gridPos": {
        "x": 5,
        "y": 1,
        "w": 5,
        "h": 4
      }
    },
    {
      "title": "Saved GB/day",
      "description": "Saved events/day x each stream's average _source size, scaled to billed bytes per event.",
      "type": "stat",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"noise_savings_total\" and r.source == \"all\" and r._field == \"saved_gb_day\")\n  |> keep(columns: [\"_time\", \"_value\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decgbytes",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "noValue": "0",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "value"
      },
      "id": 104,
      "gridPos": {
        "x": 10,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "title": "Filters by status",
      "description": "working: under 5% of its baseline still matches; partial; leaking: still matches (75%+ of the baseline, or 1+/day with no baseline), so Defend isn't dropping it; drifted: matches nothing, but the program it was made for still sends as much (its command line changed); not matching: nothing to measure; untranslatable: no search for it.",
      "type": "stat",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: -7d)\n  |> filter(fn: (r) => r._measurement == \"noise_savings_total\" and r.source == \"all\")\n  |> filter(fn: (r) => r._field == \"working\" or r._field == \"partial\" or r._field == \"leaking\" or r._field == \"drifted\" or r._field == \"not_matching\" or r._field == \"untranslatable\")\n  |> last()\n  |> keep(columns: [\"_time\", \"_value\", \"_field\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "noValue": "0"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "${__field.labels._field}"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*(leaking|drifted).*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*partial.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*working.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "id": 105,
      "gridPos": {
        "x": 14,
        "y": 1,
        "w": 10,
        "h": 4
      }
    },
    {
      "title": "Per filter: baseline, now, saved",
      "type": "table",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "description": "Latest metrics run, one row per event filter, sorted by $ saved. Baseline from: window (days before creation still in Elasticsearch), the InfluxDB record from when it was first seen, run (noise-agent run folder), description (noise-cut.py's count at creation), or unknown. Search approx: descendants match direct children only.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "query": "data = from(bucket: \"${bucket}\")\n  |> range(start: -7d)\n  |> filter(fn: (r) => r._measurement == \"noise_filter_effect\")\nlatest = (data\n  |> filter(fn: (r) => r._field == \"saved_per_day\")\n  |> keep(columns: [\"_time\"])\n  |> group()\n  |> max(column: \"_time\")\n  |> findRecord(fn: (key) => true, idx: 0))._time\ndata\n  |> filter(fn: (r) => r._time == latest)\n  |> pivot(rowKey: [\"_time\", \"filter_id\", \"name\", \"source\", \"os\", \"status\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> keep(columns: [\"name\", \"source\", \"os\", \"created\", \"baseline_per_day\", \"current_per_day\", \"saved_per_day\", \"saved_gb_day\", \"saved_usd_month\", \"status\", \"baseline_source\", \"translation\", \"avg_bytes\", \"size_from\", \"note\"])\n  |> sort(columns: [\"saved_usd_month\"], desc: true)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "name"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 520
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "saved_gb_day"
            },
            "properties": [
              {
                "id": "unit",
                "value": "decgbytes"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "saved_usd_month"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "current_per_day"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "avg_bytes"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "working": {
                        "color": "green",
                        "index": 0
                      },
                      "partial": {
                        "color": "orange",
                        "index": 1
                      },
                      "leaking": {
                        "color": "red",
                        "index": 2
                      },
                      "not matching": {
                        "color": "text",
                        "index": 3
                      },
                      "untranslatable": {
                        "color": "purple",
                        "index": 4
                      },
                      "too new": {
                        "color": "blue",
                        "index": 5
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": true,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": [
            "saved_per_day",
            "saved_gb_day",
            "saved_usd_month"
          ]
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "name": 0,
              "source": 1,
              "os": 2,
              "created": 3,
              "baseline_per_day": 4,
              "current_per_day": 5,
              "saved_per_day": 6,
              "saved_gb_day": 7,
              "saved_usd_month": 8,
              "status": 9,
              "baseline_source": 10,
              "translation": 11,
              "avg_bytes": 12,
              "size_from": 13,
              "note": 14
            },
            "renameByName": {
              "name": "Filter",
              "source": "Source",
              "os": "OS",
              "created": "Created",
              "baseline_per_day": "Baseline/day",
              "current_per_day": "Now/day",
              "saved_per_day": "Saved/day",
              "saved_gb_day": "GB/day",
              "saved_usd_month": "$/month",
              "status": "Status",
              "baseline_source": "Baseline from",
              "translation": "Search",
              "avg_bytes": "Bytes/event",
              "size_from": "Size from",
              "note": "Note"
            }
          }
        }
      ],
      "id": 106,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 14
      }
    },
    {
