# Metrics (metrics/run.sh, README "Metrics"). Copy to metrics/config/metrics.env, chmod 600.
# No Elastic key here: metrics/config/read.env holds ELASTIC_API_KEY=<read-only key>, with read on logs-* and
# Kibana "Security: Event Filters: Read" (to list the filters). It is checked to be read-only before use.

# The Elasticsearch endpoint, as in agent/config/agent.env.
ELASTIC_URL=https://<project>.es.<region>.<provider>.elastic.cloud
# KIBANA_URL=https://<project>.kb.<region>.<provider>.elastic.cloud   # optional, defaults to .es. -> .kb.

# InfluxDB v2 and its token (write and read on the bucket).
# INFLUXDB_URL=https://influxdb.example.lan
# INFLUXDB_ORG_ID=<org ID: InfluxDB -> About>
# INFLUXDB_BUCKET=noise-cut
# INFLUXDB_API_KEY=<InfluxDB token>
# A private CA: its root certificate (path from the repo root, or absolute). Or, if you only have the
# server's own certificate, its SHA-256 (openssl x509 -noout -fingerprint -sha256); renew it with the cert.
# INFLUXDB_CA_FILE=metrics/config/my-root-ca.crt
# INFLUXDB_CERT_SHA256=AA:BB:...

# The bill: an Elastic Cloud API key with the Viewer role on the security project, Cloud API access only.
# EC_API_KEY=<Elastic Cloud API key>
# EC_PROJECT_ID=<only if the key sees more than one security project>
# ECU_USD=1   # dollars per ECU (1 at list price)
# Grafana (--push-dashboard): an Editor token, the dashboard uid and the Flux data source uid.
# GRAFANA_URL=https://grafana.example.lan
# GRAFANA_API_KEY=<Grafana service account token>
# GRAFANA_DASHBOARD_UID=<dashboard uid>
# GRAFANA_DATASOURCE_UID=<InfluxDB Flux data source uid>
# GRAFANA_CA_FILE=metrics/config/my-root-ca.crt   # defaults to INFLUXDB_CA_FILE
